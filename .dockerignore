# Repository and local development metadata
.git/
.gitignore
.github/
.vscode/
.idea/
*.code-workspace

# Secrets and local configuration
.env
.env.*
!.env.example

# Python virtual environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
htmlcov/

# Local databases and database artifacts
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Generated or uploaded media
src/kagora/media/*

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Logs and temporary files
*.log
*.tmp
*.temp

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini
